@startuml
left to right direction

actor "Utilisateur" as U
actor "Administrateur" as A


rectangle "Boutique de loisirs créatifs" {
    usecase "Consulter les articles" as UC1
    usecase "Consulter le panier" as UC2
    usecase "Ajouter un article au panier" as UC3
    usecase "Retirer un article du panier" as UC4
    usecase "Passer une commande" as UC5
    usecase "Confirmer la commande" as UC6

    usecase "Gérer les articles" as UC7
    usecase "Gérer les catégories" as UC8
    usecase "S'authentifier" as UC9

}
U -- UC5
U -- UC1
U -- UC2

A -- UC7
A -- UC8

UC1 <.. UC3 : <<extend>>
UC1 <.. UC4 : <<extend>>
UC5 ..> UC6 : <<include>>

UC2 ..> UC9 : <<include>>
UC3 ..> UC9 : <<include>>
UC4 ..> UC9 : <<include>>
UC5 ..> UC9 : <<include>>
UC7 ..> UC9 : <<include>>
UC8 ..> UC9 : <<include>>

A -[hidden]right- U

@enduml